# Use ONE wallet source. Never put a real secret in this example file.
# Same derivation as nanopayment-x402: m/44'/60'/0'/0/0.
OWS_MNEMONIC=
# Alternatively, a 0x-prefixed 32-byte private key:
X402_PRIVATE_KEY=

BASE_RPC_URL=https://mainnet.base.org
# Per-request cap, not a spending allowance. CLI --max-usdc overrides it.
MAX_PAYMENT_USDC=0.02
# Optional independent recipient allowlist (comma-separated addresses).
EXPECTED_PAY_TO=

# API and RPC calls both honor these, including lowercase variants and NO_PROXY.
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
